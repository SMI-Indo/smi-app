generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  ADMIN
}

enum EventCategory {
  WEBINAR
  TEMU_ONLINE
  WORKSHOP
  ACARA
}

enum EventStatus {
  COMPLETED
  UPCOMING
}

enum VideoCategory {
  TUTORIAL
  GALLERY
  FUN_FACT
}

enum TransactionType {
  CLAIM_TASK
  REDEEM_REWARD
}

model User {
  id              String            @id @default(cuid())
  name            String?
  nickname        String?
  email           String            @unique
  emailVerified   DateTime?
  password        String?
  image           String?
  role            Role              @default(MEMBER)
  isApproved      Boolean           @default(false) // Status ACC dari Pengurus/Admin SMI
  violationPoints Int               @default(0)     // Akumulasi poin pelanggaran
  parish          String?           // Asal Paroki / Keuskupan
  rank            String?           // Pangkat Misdinar (e.g. Mula, Madya, Utama, Pembina)
  memberId        String?           @unique         // ID Unik diinput manual oleh Admin (e.g. SMI-ONLINE-001)
  phone           String?           // Nomor HP / WhatsApp
  coins           Int               @default(0)
  attendanceCount Int               @default(0)
  cardValidUntil  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  accounts        Account[]
  sessions        Session[]
  transactions    UserTransaction[]
  violations      ViolationRecord[]
  quizAttempts    UserQuizAttempt[]
}

model ViolationRecord {
  id          String   @id @default(cuid())
  userId      String
  points      Int      // Jumlah poin pelanggaran (+5, +10, dsb.)
  reason      String   // Alasan pelanggaran (misal: "Absen pertemuan online tanpa keterangan")
  date        DateTime @default(now())
  createdById String?  // ID pengurus/admin pencatat
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id          String        @id @default(cuid())
  title       String
  description String?
  category    EventCategory @default(TEMU_ONLINE)
  date        DateTime
  time        String        // e.g. "19:00 - 21:00 WIB (Zoom)"
  location    String        // e.g. "Zoom Meeting / Google Meet SMI"
  status      EventStatus   @default(UPCOMING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Video {
  id          String        @id @default(cuid())
  title       String
  description String?
  category    VideoCategory @default(TUTORIAL)
  videoUrl    String
  thumbnail   String?
  duration    String        // e.g. "05:30"
  author      String        @default("SMI Media")
  viewsCount  Int           @default(0)
  isFeatured  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model MissionTask {
  id          String   @id @default(cuid())
  title       String
  description String?
  rewardCoins Int      @default(5)
  category    String   @default("Kegiatan Online")
  createdAt   DateTime @default(now())
}

model Quiz {
  id          String            @id @default(cuid())
  title       String
  description String?
  rewardCoins Int               @default(10)
  createdAt   DateTime          @default(now())

  questions   QuizQuestion[]
  attempts    UserQuizAttempt[]
}

model QuizQuestion {
  id          String   @id @default(cuid())
  quizId      String
  question    String
  options     String[]
  correctIdx  Int
  explanation String?

  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model UserQuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  score     Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
}

model UserTransaction {
  id          String          @id @default(cuid())
  userId      String
  amount      Int
  type        TransactionType
  description String
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reward {
  id          String   @id @default(cuid())
  title       String
  description String?
  coinCost    Int
  imageUrl    String?
  stock       Int      @default(10)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model NewsletterSubscription {
  id           String   @id @default(cuid())
  contact      String   @unique // Email or WhatsApp (+62...)
  subscribedAt DateTime @default(now())
}
